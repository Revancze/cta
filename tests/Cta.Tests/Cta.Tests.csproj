<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" />
    <PackageReference Include="Allure.Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cta.Contracts\Cta.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Cta.Core\Cta.Core.csproj" />
    <ProjectReference Include="..\..\src\Cta.Storage\Cta.Storage.csproj" />
    <ProjectReference Include="..\..\src\Cta.Cli\Cta.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="allureConfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Allure appends to its results directory; start every test run from an empty one. -->
  <Target Name="CleanAllureResults" BeforeTargets="VSTest">
    <RemoveDir Directories="$(MSBuildThisFileDirectory)..\..\allure-results" />
  </Target>
  <ItemGroup>
    <None Include="Samples/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
